meta <- utils::packageDescription("lpanda")

citHeader("To cite 'lpanda' in publications, please use:")

bibentry(
  bibtype = "Manual",
  title   = sprintf("{%s}: %s", meta$Package, meta$Title),
  author  = eval(parse(text = meta$`Authors@R`)),
  year    = if (!is.null(meta$Date)) substr(meta$Date, 1, 4) else
              format(Sys.Date(), "%Y"),
  note    = sprintf("R package version %s", meta$Version),
  url     = if (!is.null(meta$URL)) strsplit(meta$URL, ",")[[1]][1],
  doi     = "10.32614/CRAN.package.lpanda"
)